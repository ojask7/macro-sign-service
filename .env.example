# =============================================================================
# Macro Sign Service - Environment Configuration
# =============================================================================
# Copy this file to .env and update values for your environment

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
APP_NAME=macro-sign-service
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_SECRET_KEY=change-me-to-a-random-secret-key-in-production

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://macrosign:macrosign@localhost:5432/macrosign
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Celery Task Queue
# -----------------------------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=change-me-to-a-random-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=10080
API_KEY_HEADER=X-API-Key

# -----------------------------------------------------------------------------
# Certificate Management
# -----------------------------------------------------------------------------
# Options: local, hashicorp_vault, aws_kms, azure_keyvault
CERT_STORE_BACKEND=local

# Local certificate store (development only)
CERT_LOCAL_CERT_PATH=./certs/signing_cert.pem
CERT_LOCAL_KEY_PATH=./certs/signing_key.pem

# HashiCorp Vault
VAULT_URL=http://localhost:8200
VAULT_TOKEN=
VAULT_MOUNT_POINT=secret
VAULT_CERT_PATH=macro-sign/cert

# AWS KMS
AWS_REGION=us-east-1
AWS_KMS_KEY_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Azure Key Vault
AZURE_KEYVAULT_URL=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Signing Configuration
# -----------------------------------------------------------------------------
SIGNING_DEFAULT_ALGORITHM=sha256
SIGNING_MAX_FILE_SIZE_MB=50
SIGNING_ALLOWED_EXTENSIONS=.vba,.bas,.cls,.frm,.vbs,.xlsm,.xlsb,.docm,.pptm,.xltm,.dotm,.potm
# Enable VBA project signing (embeds signature visible in Office)
SIGNING_USE_VBA_SIGNING=true
# Password for PFX certificates (empty for no password)
SIGNING_PFX_PASSWORD=

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ALLOW_CREDENTIALS=true

# -----------------------------------------------------------------------------
# Webhook
# -----------------------------------------------------------------------------
WEBHOOK_TIMEOUT_SECONDS=30
WEBHOOK_MAX_RETRIES=3

# -----------------------------------------------------------------------------
# Monitoring
# -----------------------------------------------------------------------------
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
