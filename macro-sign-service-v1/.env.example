# Server
MACRO_SIGN_HOST=0.0.0.0
MACRO_SIGN_PORT=8000

# Certificates
MACRO_SIGN_CERTS_DIR=certs
MACRO_SIGN_DEFAULT_CERT_NAME=default
MACRO_SIGN_PFX_PASSWORD=

# Database
MACRO_SIGN_DB_PATH=audit.db

# Auth (leave blank to disable)
MACRO_SIGN_API_KEY=

# Limits
MACRO_SIGN_MAX_FILE_SIZE_MB=50

# Allowed extensions
MACRO_SIGN_ALLOWED_EXTENSIONS=.xlsm,.docm,.pptm,.xlam,.dotm,.ppam,.vba,.bas,.cls,.frm
